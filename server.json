{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.yehyatt/sdk-release-kit",
  "title": "SDK Release Kit",
  "description": "Build and ship mobile SDK demo apps and packages to a shared folder, Google Play and TestFlight.",
  "repository": {
    "url": "https://github.com/yehyatt/sdk-release-kit",
    "source": "github"
  },
  "websiteUrl": "https://github.com/yehyatt/sdk-release-kit",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "sdk-release-kit",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
